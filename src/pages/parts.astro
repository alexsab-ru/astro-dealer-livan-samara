---
import PageLayout from '@/layouts/PageLayout.astro';
import CardMedia from '@/components/CardMedia/CardMedia.astro';
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button/Button.astro';
---

<PageLayout
  h1="Запчасти и аксессуары"
  title={`Запчасти и аксессуары Livan`}
  description=""
  breadcrumb={[{name:"Запчасти и аксессуары",href:""}]}
>
  <p><strong>Оригинальные запасные части разработаны с учетом требований безопасности и стандартов качества автопроизводителя.</strong></p>
  <p>Высокое качество оригинальных запчастей, подтвержденное множественными испытаниями, — это залог длительного срока службы и надежности в процессе эксплуатации.</p>
  <p>Использование неоригинальных запасных частей и комплектующих может повлечь за собой отказ от гарантии и риск возникновения дефектов.</p>
  <p>Обратитесь к официальному дилеру LIVAN для приобретения оригинальных запасных частей и аксессуаров для вашего автомобиля.</p>

  <h2 class="mt-10">Скачать каталоги</h2>
  <div class="mb-10">
    <CardMedia imgPlacement="right">
      <Fragment slot="card-image">
        <img 
          src="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/s6pro.webp" 
          alt="Каталог аксессуаров LIVAN S6PRO" 
          class="w-full h-full object-cover"
        />
      </Fragment>
      <Fragment slot="card-content">
        <div>
          <h3 class="text-2xl font-bold mb-4">LIVAN S6PRO</h3>
          <p class="text-gray-700 mb-4 flex items-center gap-1">
            <Icon name="mdi:zip-box-outline" class="text-xl" />
            <span>Каталог аксессуаров LIVAN S6PRO (2.17 MB)</span>
          </p>
          <Button
            view="link"
            url="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/s6pro.zip"
            title="Скачать каталог"
            icon="mdi:download"
            iconClasses="ml-2"
            classes="inline-flex items-center"
          />
        </div>
      </Fragment>
    </CardMedia>
  </div>

  <div class="mb-10">
    <CardMedia imgPlacement="right">
      <Fragment slot="card-image">
        <img 
          src="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/x6pro.webp" 
          alt="Каталог аксессуаров LIVAN X6PRO" 
          class="w-full h-full object-cover"
        />
      </Fragment>
      <Fragment slot="card-content">
        <div>
          <h3 class="text-2xl font-bold mb-4">LIVAN X6PRO</h3>
          <p class="text-gray-700 mb-4 flex items-center gap-1">
            <Icon name="mdi:zip-box-outline" class="text-xl" />
            <span>Каталог аксессуаров LIVAN X6PRO (1.98 MB)</span>
          </p>
          <Button
            view="link"
            url="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/x6pro.zip"
            title="Скачать каталог"
            icon="mdi:download"
            iconClasses="ml-2"
            classes="inline-flex items-center"
          />
        </div>
      </Fragment>
    </CardMedia>
  </div>

  <CardMedia imgPlacement="right">
    <Fragment slot="card-image">
      <img 
        src="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/x3pro.webp" 
        alt="Каталог аксессуаров LIVAN X3PRO" 
        class="w-full h-full object-cover"
      />
    </Fragment>
    <Fragment slot="card-content">
      <div>
        <h3 class="text-2xl font-bold mb-4">LIVAN X3PRO</h3>
        <p class="text-gray-700 mb-4 flex items-center gap-1">
          <Icon name="mdi:zip-box-outline" class="text-xl" />
          <span>Каталог аксессуаров LIVAN X3PRO (2.20 MB)</span>
        </p>
        <Button
          view="link"
          url="https://cdn.alexsab.ru/pages/livan/livan-samara/parts/x3pro.zip"
          title="Скачать каталог"
          icon="mdi:download"
          iconClasses="ml-2"
          classes="inline-flex items-center"
        />
      </div>
    </Fragment>
  </CardMedia>
</PageLayout>