---
import PageLayout from '@/layouts/PageLayout.astro';
import FeedbackForm from '@/components/FeedbackForm/FeedbackForm.astro';
import Faq from '@/components/Faq/Index.astro';
import { type TFaqItem } from '@/components/Faq/types';

// FAQ данные о гарантии LIVAN
const faqItems: TFaqItem[] = [
  {
    id: 1,
    question: "Гарантия на новый автомобиль",
    answer: "<p>Срок службы автомобиля: 5 лет с даты продажи, 150 000 км пробега.*</p><p>На новый автомобиль: 4 года с даты продажи, 100 000 км пробега.*</p><p><small class='italic'>*С даты продажи автомобиля первому покупателю, указанной в гарантийном свидетельстве «Сервисной книжки» или 150 000 км пробега, в зависимости от того, что наступит раньше.</small></p><p>На отдельные комплектующие деталей автомобиля установлен другой гарантийный срок.</p>",
    open: false
  },
  {
    id: 2,
    question: "Гарантия на составляющие части автомобиля",
    answer: "<p><strong>На составляющие части (детали, узлы), перечисленные ниже, устанавливается гарантийный период большей продолжительности.</strong></p><p>Для новых автомобилей: 5 лет с даты продажи, 150 000 км пробега.*</p><p><small class='italic'>*С даты продажи автомобиля первому покупателю, указанной в гарантийном свидетельстве «Сервисной книжки» или 150 000 км пробега, в зависимости от того, что наступит раньше.</small></p><ul><li>блок цилиндров, коленчатый вал, коренные и шатунные вкладыши, поршень, поршневые кольца, поршневой палец, шатун;</li><li>ГБЦ, распределительные валы, клапана;</li><li>корпус МКПП, CVT и DCT, валы, шестерни МКПП, CVT и DCT, дифференциал МКПП, CVT и DCT в сборе.</li></ul><p class='mt-10'><strong>На составляющие части (детали, узлы или агрегаты) автомобиля, перечисленные ниже, устанавливается гарантийный период меньшей продолжительности</strong></p><p>Для новых автомобилей: 3 года с даты продажи, 60 000 км пробега.*</p><p><small class='italic'>*С даты продажи автомобиля первому покупателю, указанной в гарантийном свидетельстве «Сервисной книжки» или 60 000 км пробега, в зависимости от того, что наступит раньше.</small></p><ol class='list-decimal list-inside mt-4 space-y-1 text-sm'><li>амортизаторы передние и задние, опоры и поворотные подшипники амортизаторов;</li><li>шаровые шарниры деталей подвески и рулевого управления, сайлент блоки рычагов передней и задней подвески, приводы колес;</li><li>все виды подшипников;</li><li>мультимедийная система (GPS), динамики;</li><li>резинотехнические изделия, сальники;</li><li>генератор, стартер, высоковольтные провода, катушки зажигания;</li><li>ремни приводные, натяжные устройства и ролики ремней приводных;</li><li>компоненты выпускной системы, включая каталитические нейтрализаторы, датчики кислорода;</li><li>нажимной диск сцепления (корзина), маховик, тормозные диски;</li><li>термостат, турбонагнетатель, прокладка ГБЦ, водяной насос;</li><li>все виды датчиков, прикуриватель, выключатель света заднего хода, электродвигатель стеклоочистителя, дверные замки, стеклоподъемники, фары, часовая пружина;</li><li>электроусилитель рулевого управления и промежуточный рулевой вал, рулевая рейка и рулевые тяги в сборе;</li><li>устройство экстренного вызова ЭРА-ГЛАНАСС;</li><li>элементы системы кондиционирования;</li><li>блок BCM, ЭБУ ДВС, блок управления IMMO, ЭБУ CVT, топливный насос, топливные форсунки, топливные трубки, электронная дроссельная заслонка, комбинация приборов, PCV клапан, клапан VVT, кнопка старт/стоп в сборе с антенной.</li></ol><p class='mt-4 text-xs italic'>* - в случае механического повреждения пыльника шарового соединения или пыльника ШРУС привода колеса гарантия на соответствующие шаровое соединение или ШРУС привода колеса аннулируется.</p>",
    open: false
  },
  {
    id: 3,
    question: "Гарантия на лакокрасочное покрытие (ЛКП) и от сквозной коррозии",
    answer: "<p><strong>Гарантия Дистрибьютора на лакокрасочное покрытие кузова</strong></p><p>Условия гарантии распространяются, если повреждения были вызваны использованием некачественных материалов или нарушением технологии производства Изготовителем.</p><p>Для новых автомобилей: 3 года с даты продажи, 60 000 км пробега.*</p><p><small class='italic'>*С даты продажи автомобиля первому покупателю, указанной в гарантийном свидетельстве «Сервисной книжки» или 60 000 км пробега, в зависимости от того, что наступит раньше.</small></p><p class='mt-10'><strong>Гарантия Дистрибьютора на отсутствие сквозной коррозии на металлических кузовных деталях</strong></p><p>Условия гарантии распространяются, если повреждения были вызваны использованием некачественных материалов или нарушением технологии производства Изготовителем.</p><p>Для новых автомобилей: 5 лет с даты продажи, 150 000 км пробега.*</p><p><small class='italic'>*С даты продажи автомобиля первому покупателю, указанной в гарантийном свидетельстве «Сервисной книжки» или 150 000 км пробега, в зависимости от того, что наступит раньше.</small></p>",
    open: false
  },
  {
    id: 4,
    question: "Не гарантия",
    answer: "<ul class='list-disc list-inside mt-4 space-y-1 text-sm'><li>Шины, тормозные колодки, ведомый диск сцепления;</li><li>Воздушный фильтр, масляный фильтр, топливный фильтр, свечи зажигания;</li><li>Элементы питания пультов дистанционного управления, лампочки, предохранители и обычное реле (исключая встроенные в блок управления), АКБ;</li><li>Щетки стеклоочистителя, стекла;</li><li>Допустимый расход масла, консистентной смазки, тормозной жидкости, охлаждающей жидкости, хладагента;</li><li>Эксплуатационный износ и естественное изменение состояния деталей и узлов;</li><li>Бортовые инструменты, устанавливаемые на автомобиль аксессуары.</li></ul>",
    open: false
  }
];
---

<PageLayout
  h1="Гарантия"
  title={`Гарантия`}
  description=""
  breadcrumb={[{name:"Гарантия",href:""}]}
>
  <p>Гарантия качества на автомобиль и оригинальные запасные части марки LIVAN предоставляемая производителем в течение гарантийного срока, 5 лет после покупки или в течение 150 000 км пробега, в зависимости от того, что наступит раньше.</p>
  <div class="flex gap-10 mt-10">
    <div>
      <div class="text-gray-700 text-4xl font-bold">5 лет</div>
      <div class="text-gray-400">после покупки</div>
    </div>
    <div>
      <div class="text-gray-700 text-4xl font-bold">150 000 км</div>
      <div class="text-gray-400">пробега</div>
    </div>
  </div>

  <Faq items={faqItems} title="" class="mt-16" />

</PageLayout>